# Public Supabase project URL and publishable/anon key. NOT the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server ONLY. Obtain from your own Supabase project.
SUPABASE_SERVICE_ROLE_KEY=
# Exact deployed origin, no trailing slash. Local development: http://localhost:3000
APP_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact widget hostname, e.g. book.your-domain.com (not a URL)
TURNSTILE_HOSTNAME=
# Generate separate strong random values in your hosting environment.
RATE_LIMIT_SECRET=
CRON_SECRET=
# Server ONLY. Verified Resend sender required; cannot be an arbitrary Gmail From address.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=parassagwal0@gmail.com
